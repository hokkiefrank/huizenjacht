# Local development: copy to .env.local (see README → Local development)
DATABASE_URL=postgres://localhost/huizen
# Public base URL, used for invite links and the bookmarklet
APP_URL=http://localhost:3000

# Optional: the app's name (short, e.g. in the navigation bar) and full name (browser tab)
# APP_NAME=Huizenjacht
# APP_TITLE=Onze huizenjacht

# Optional: Claude API key for the preference profile (console.anthropic.com)
# ANTHROPIC_API_KEY=
