# /opt/huizen/.env on the server (see README → Production). chmod 600, owned by the deploy user.
# Never commit the real file.

# Database password, e.g. from: openssl rand -hex 32
POSTGRES_PASSWORD=

# Your domain, without https:// (Caddy gets a certificate for it)
SITE_ADDRESS=huizen.example.com
# The same, as the full public URL
APP_URL=https://huizen.example.com
# Other addresses that should redirect to APP_URL, comma-separated (e.g. www). Leave a dummy if none:
# Caddy needs a value here.
REDIRECT_ADDRESSES=www.huizen.example.com

# Name shown in the app: short (navigation bar, home screen) and in full (browser tab)
APP_NAME=Huizenjacht
APP_TITLE="Onze huizenjacht"

# Claude Code subscription token for the agent container, from `claude setup-token` (Pro or Max plan)
CLAUDE_CODE_OAUTH_TOKEN=
# Claude API key for the preference profile (console.anthropic.com → API keys). Only the app gets it.
ANTHROPIC_API_KEY=

# Optional: the address search alerts are forwarded to; needs an MX record pointing to this server
MAIL_ADDRESS=alerts@huizen.example.com
